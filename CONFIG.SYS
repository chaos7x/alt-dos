REM ========================================
REM AT-DOS 6.2 - CONFIG.SYS
REM Zeilen mit REM sind Erklaerungen bzw. Beispiele; zum
REM Einschalten REM weglassen. Hoechstens 8 KB, eine Zeile bis 127 Zeichen.
REM ========================================

REM --- Speicher und Dateien ---
REM FILES=n      offene Dateien fuer alle Programme zusammen (8-219; ab 4 MB
REM                mindestens 64, ab 8 MB 120 - DOS-Boxen/Windows zaehlen mit)
FILES=30
REM BUFFERS=n    Untergrenze des Platten-Cache in Sektoren (1-99)
BUFFERS=20
REM CACHE=kb,s,max  Platten-Cache im Kernel: Mindestgroesse in KB,
REM   verzoegertes Schreiben nach s Sekunden (0 = sofort), Hoechstgroesse
REM   in KB (bis 32768). Ohne Angabe nach Speicher; dazwischen waechst und
REM   schrumpft er mit dem freien Speicher. Beispiel:
REM CACHE=512,5,4096
REM SWAPPATH=X:\Verz kb  Auslagerungsdatei SWAPPER.DAT fuer DOS-Boxen;
REM   ohne Angabe bis 16 MB RAM X:\SWAP, 2x RAM (2-8 MB); OFF = keine
REM SWAPPATH=C:\SWAP 4096
REM LOOP=[X:,]Datei[,/RO]  Abbild (ISO, IMG, VHD) als Laufwerk, bis 8 Zeilen
REM LOOP=E:,C:\ISO\SPIEL.ISO
REM RUN=Programm [Argumente]  losgeloest starten wie OS/2 (ohne Tastatur,
REM   Ausgaben nach NUL), bis 8 Zeilen; ohne Pfad: Stamm, \DOS, \DOS\SYSTEM
REM RUN=PRINT.EXE /WORK
REM Zeitplandienst fuer AT (endet gleich, wenn nichts geplant ist)
RUN=AT.EXE /SERVICE

REM --- Geraetetreiber (Suche: Stamm, \DOS\SYSTEM, \DOS) ---
REM BASEDEV= wie DEVICE=, fuer Plattentreiber: zuerst geladen, beim
REM Notstart (F5 beim Start) als einzige Zeilen
REM Adaptec AHA-154x/BusLogic (ISA-SCSI)          /NOIRQ = Abfragebetrieb
BASEDEV=AHA154X.SYS
REM IDE/ATAPI, MFM/RLL/ESDI. /DMA stellt Busmaster-DMA selbst ein (PIIX4:
REM UDMA 2), /NODMA schaltet DMA ab, /NOIRQ = Abfragebetrieb
BASEDEV=IDE.SYS
REM Trantor T130B (NCR 53C400). /P:350|340|250|240 Port, /PIO ohne Block
BASEDEV=NCR5380.SYS
REM PCI-SCSI NCR/LSI 53C8xx. /NOIRQ = Abfragebetrieb, /ID:n eigene ID
BASEDEV=NCR8XX.SYS
REM Adaptec AHA-2940/2940U(W)/2944UW (PCI). /ID:n eigene ID, /NOWIDE,
REM /NOIRQ, /NODISC (Geraete trennen sich nicht vom Bus)
BASEDEV=AIC7XXX.SYS
REM SATA-Platten und -CD am AHCI-Controller (VMs, ICH6+). /NOIRQ
BASEDEV=AHCI.SYS
REM VirtIO-Platten (QEMU/Proxmox), von SETUP freigeschaltet
REM BASEDEV=VIOBLK.SYS
REM Maus: sucht PS/2, seriell, Bus. /PS2 /COM1 /COM2 /BUS legt fest
DEVICE=MOUSE.SYS
REM Sound Blaster 1.0-AWE64, OPL, MPU. /A:220 /I:5 /D:1 /H:5 /M:330
REM von Hand, /NOFM /NOMPU /NOAWE abschalten, /MPU = MIDI an den MPU-401
REM statt an den AWE-Synthesizer, /AWETEST Probeton der AWE
DEVICE=SB16.SYS
REM Netz: Karte (NE2000 /P:300 /I:3), dann TCPIP /IP:a.b.c.d/n /GW:x
REM /DNS:x /HOST:x. SETUP schaltet die gefundene Karte frei.
REM DEVICE=RTL8139.SYS
REM DEVICE=PCNET.SYS
REM DEVICE=E1000.SYS
REM DEVICE=VIONET.SYS
REM DEVICE=NE2000.SYS
REM DEVICE=TCPIP.SYS
REM Box-Module (wie OS/2-VDDs): COM/LPT, Ton, EMS, Maus; Grafik auf
REM EGA/CGA: DEVICE=VEGA.SYS bzw. VCGA.SYS
DEVICE=VCOM.SYS
DEVICE=VSB.SYS
DEVICE=VEMS.SYS
DEVICE=VMOUSE.SYS

REM --- Dateisysteme ---
REM CD-ROM: ISO 9660(:1999), Joliet, Rock Ridge (nur lesend)
IFS=ISO9660.IFS
REM Lange Namen auf FAT12/16: AUTO (was auf dem Laufwerk ist, sonst EA),
REM VFAT (wie Windows 95) oder EA (wie OS/2, EA DATA. SF). FAT32 = VFAT.
LONGNAMES=AUTO
REM Nicht sauber abgemeldete Platten beim Start pruefen: ohne Zeile alle,
REM nur bestimmte mit AUTOCHECK=CD, keine mit AUTOCHECK= (leer)
REM AUTOCHECK=CD
REM Zustand des Kernels als Textdateien (wie /proc), ab Werk aus;
REM SET PROCFS=X: legt es auf Laufwerk X:
REM SET PROCFS=P:

REM --- Land, Zeichensatz, Tastatur ---
REM COUNTRY=nnn  Datum, Uhrzeit, Zahlen wie MS-DOS: 001 USA, 002 Kanada,
REM 003 Lateinamerika, 031 NL, 032 B, 033 F, 034 E, 039 I, 041 CH, 044 GB,
REM 045 DK, 046 S, 047 N, 048 PL, 049 D, 351 P, 358 FIN, 420 CZ u. a.
COUNTRY=049
REM CODEPAGE=a,b  Zeichensaetze (erste gilt beim Start, CHCP wechselt):
REM 437 (eingebaut), 737, 850, 852, 857, 858, 860, 863, 865, 866 - nur
REM von Platte (CPnnn.FNT in \DOS\SYSTEM). Beispiel:
REM CODEPAGE=850,437
REM Tastatur: KEYB in AUTOEXEC.CMD, z. B. KEYB DK oder KEYB PL,852

REM --- Befehlsinterpreter und Umgebung ---
PROTSHELL=CMD.EXE /P
REM SET NAME=WERT legt Variablen fuer alle Sitzungen an, z. B.:
REM SET TEMP=D:\TEMP

REM --- DOS-Boxen ---
REM DOS in der HMA und obere Speicherbloecke (UMB), wie OS/2
DOS=HIGH,UMB
REM Konventioneller Speicher je Box in KB (256-640)
REM RMSIZE=640
REM Kein EMS-Seitenrahmen (64 KB mehr UMB): EMS_FRAME_LOCATION=NONE
REM EMS_FRAME_LOCATION=NONE
REM DOS-Programme aus CMD in eigener Sitzung starten (wie OS/2) statt
REM in derselben (wie NT):
REM DOSSTART=SESSION
REM Einstellungen je Programm: \DOS\MDOS\DOSBOX.INI

REM --- Hardware ---
REM ISA-PnP-Karten nicht einstellen (z. B. wenn ein PnP-BIOS es tut)
REM PNP=OFF
REM SHUTDOWN schaltet ueber ACPI/APM aus; APM=OFF: nur Meldung,
REM ACPI=OFF: nur ueber APM
REM APM=OFF
