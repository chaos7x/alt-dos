REM AT-DOS 5.0 - Geraetetreiber
REM Adaptec AHA-154x (SCSI) und IDE-Platten (bis zu vier)
FILES=30
BUFFERS=20
STACKS=9,256
DEVICEHIGH /L:1 =AHA154X.SYS
DEVICE=IDE.SYS
DEVICE=NCR5380.SYS
DEVICE=MOUSE.SYS
DEVICE=SB16.SYS
IFS=ISO9660.IFS
PROTSHELL=CMD.EXE /P
REM Nicht sauber abgemeldete Platten beim Start pruefen: alle,
REM nur bestimmte mit AUTOCHECK=CD, keine mit AUTOCHECK=
