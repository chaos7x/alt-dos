;  LINUX.MAC - DOSKEY-Makros mit den gewohnten Namen von Linux.
;  Nicht aktiv. Laden mit  DOSKEY /MACROFILE=C:\DOS\LINUX.MAC
;  (z. B. in AUTOEXEC.CMD), anzeigen mit  DOSKEY /MACROS.
;  Zeilen name=text, $1-$9 Argumente, $* alle, $T trennt Befehle.
;  Schalter bleiben die von AT-DOS (DIR /A statt ls -a). cat, grep,
;  less, head, tail, wc, uniq, tr, cut, strings, md5sum, sha1sum, hexdump,
;  xxd, dmesg, tar, gzip sind eigene
;  Programme.
ll=DIR /O $*
la=DIR /A /O $*
ls=DIR /W /O $*
l=DIR /W /O $*
..=CD ..
pwd=CD
cp=COPY $*
mv=MOVE $*
rm=DEL $*
clear=CLS
diff=FC $*
man=HELP $*
free=MEM $*
ps=TASKMAN /L
kill=TASKMAN /K $*
modprobe=DEVLOAD $*
lsmod=DEVLOAD /L
rmmod=DEVLOAD /U $*
mount=LOOP $*
umount=LOOP $1 /D
uname=VER
history=DOSKEY /HISTORY
nano=EDIT $*
vi=EDIT $*
mc=FM $*
