/*
 * AT-DOS GUI - Vorlagen der Standarddialoge (COMMDLG) im Stil von Windows 3.1.
 *
 * Herkunft: Wine, dlls/comdlg32/comdlg32.rc (Dialoge OPEN_FILE bis
 * REPLACEDLGORD), Copyright 1999 Bertho Stultiens, 1999 Klaas van Gend und
 * die Wine-Autoren; Texte aus Wine po/de.po (deutsche Uebersetzung), einige
 * Texte gekuerzt/geaendert ("Dateityp", "Speichern unter", "Speichern",
 * "Schreibschutz" - unsere Schrift ist 8 Punkte breit).
 * Lizenz der Vorlage: GNU LGPL 2.1 oder spaeter - als Teil von AT-DOS unter
 * GPL-2.0-or-later weitergegeben (LGPL 2.1 Abschnitt 3).
 * Groesse und Steuerelement-Nummern wie bei Windows: Programme mit eigenen
 * Vorlagen (ENABLETEMPLATE) und Hooks verlassen sich darauf.
 * tools/rc2dlg.py macht daraus beim Bauen 16-Bit-DLGTEMPLATEs (build/cdlgtpl.h).
 */

OPEN_FILE DIALOG 36, 24, 275, 134
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Öffnen"
FONT 8, "MS Shell Dlg"
{
 LTEXT "Datei&name:", stc3, 6, 6, 76, 9
 EDITTEXT edt1, 6, 16, 90, 12, ES_AUTOHSCROLL | ES_OEMCONVERT | WS_BORDER | WS_TABSTOP
 LISTBOX lst1, 6, 32, 90, 68, LBS_STANDARD | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_DISABLENOSCROLL | WS_TABSTOP
 LTEXT "&Verzeichnisse:", -1, 110, 6, 92, 9
 LTEXT "", stc1, 110, 18, 92, 9, SS_NOPREFIX | WS_GROUP
 LISTBOX lst2, 110, 32, 92, 68, LBS_STANDARD | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_DISABLENOSCROLL | WS_TABSTOP
 LTEXT "Datei&typ:", stc2, 6, 104, 90, 9
 COMBOBOX cmb1, 6, 114, 90, 60, CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_BORDER | WS_VSCROLL | WS_TABSTOP
 LTEXT "&Laufwerke:", stc4, 110, 104, 92, 9
 COMBOBOX cmb2, 110, 114, 92, 68, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_AUTOHSCROLL | CBS_SORT | CBS_HASSTRINGS | WS_BORDER | WS_VSCROLL | WS_TABSTOP
 DEFPUSHBUTTON "Öffnen", IDOK, 208, 6, 60, 14, BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP
 PUSHBUTTON "Abbrechen", IDCANCEL, 208, 24, 60, 14, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&Hilfe", pshHelp, 208, 46, 60, 14, WS_GROUP | WS_TABSTOP
 CHECKBOX "&Schreibschutz", chx1, 208, 68, 65, 12, BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP
}

